# --- Model (pi-ai). Set the key for whichever provider you use. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TOMO_MODEL_PROVIDER=anthropic
TOMO_MODEL_ID=claude-sonnet-5-5
TOMO_SMALL_MODEL_ID=claude-haiku-5-5      # subagents + reflection
# TOMO_MODEL_PROVIDER=openai / TOMO_MODEL_ID=gpt-6-sol / TOMO_SMALL_MODEL_ID=gpt-6-luna

# --- Identity ---
TOMO_NAME=Tomo
TOMO_TIMEZONE=Asia/Taipei
# Your ids on each platform. DMs from these share one continuous conversation.
# Leave empty on first run: DM the bot and it replies with your id.
TOMO_OWNERS=telegram:123456789,discord:111111111111111111,slack:U0123456789
TOMO_ALLOWED=                             # others who may talk to it in groups

# --- Surfaces (any subset) ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...                  # Socket Mode, connections:write

# --- Web / app API ---
PORT=8787
TOMO_API_TOKEN=change-me-to-a-long-random-string

# --- Evolution ---
TOMO_REFLECT_EVERY=6                      # reflect every N answered turns
TOMO_DATA_DIR=./data
