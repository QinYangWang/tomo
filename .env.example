# Optional. Everything below can be set in the web UI (Settings) instead, and values saved
# there win. Use this file only for headless setups or to change the port / data dir.

# --- Model (pi-ai). Set the key for whichever provider you use. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=                          # Google AI Studio key
TOMO_MODEL_PROVIDER=anthropic
TOMO_MODEL_ID=claude-sonnet-5-5
TOMO_SMALL_MODEL_ID=claude-haiku-5-5      # subagents + reflection
# TOMO_MODEL_PROVIDER=openai / TOMO_MODEL_ID=gpt-6-sol / TOMO_SMALL_MODEL_ID=gpt-6-luna
# TOMO_MODEL_PROVIDER=google / TOMO_MODEL_ID=gemini-3.1-pro-preview / TOMO_SMALL_MODEL_ID=gemini-3.8-flash

# --- Identity ---
TOMO_NAME=Tomo
TOMO_TIMEZONE=Asia/Taipei
# Your ids on each platform. DMs from these share one continuous conversation.
# Leave empty on first run: DM the bot and it replies with your id.
TOMO_OWNERS=telegram:123456789,discord:111111111111111111,slack:U0123456789
TOMO_ALLOWED=                             # others who may talk to it in groups

# --- Surfaces (any subset) ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...                  # Socket Mode, connections:write

# --- Web / app API ---
PORT=8787
TOMO_API_TOKEN=                           # optional static API token for scripts; the web UI uses password login

# --- Evolution ---
TOMO_REFLECT_EVERY=6                      # reflect every N answered turns
TOMO_DATA_DIR=./data

# Project repositories on S3-compatible storage (optional; the web UI's 设置 → 存储 wins).
# Without these, repositories live in data/objects.
# TOMO_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# TOMO_S3_BUCKET=tomo
# TOMO_S3_REGION=auto
# TOMO_S3_ACCESS_KEY_ID=
# TOMO_S3_SECRET_ACCESS_KEY=
# TOMO_S3_PREFIX=
